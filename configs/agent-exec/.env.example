# ~/agent-exec/.env  (mode 600)
#
# agent_exec.py is byte-identical on every host -- this file is what makes an
# instance behave like "the server" or "the GPU box". Confirm with md5sum on
# both hosts after any edit to the Python.

# Bearer token for the tool endpoints. The SAME value must also appear in the
# Open WebUI tool-server connection for this host. A 403 from one host and not
# the other means these have drifted; a 401 means no token was sent at all.
AGENT_EXEC_KEY=<REDACTED>

# Per-host slug -> operation ids (server_read, mothership_read, ...).
# Open WebUI names tools by bare operationId with NO server prefix, so two
# hosts sharing a slug collide and the model can no longer address one machine.
# Any additional host needs its own unique slug, and Open WebUI must be
# restarted to re-fetch the specs.
AGENT_EXEC_SLUG=<host-slug>

# Public base URL for this instance, used in approval links.
AGENT_EXEC_URL=http://<LAN_IP>:8893

# Approval pushes. The action buttons embed the bearer token, so treat this
# topic as credential-bearing -- see docs/local-ai.md, "Known tradeoffs".
NTFY_URL=http://<LAN_IP>:8095/<approval-topic>
NTFY_TOKEN=<REDACTED>

# Set ONLY on the GPU host. Its presence is what enables the Ollama inference
# tracker, so the same Python file stays byte-identical on a host with no GPU.
# OLLAMA_URL=http://127.0.0.1:11434
